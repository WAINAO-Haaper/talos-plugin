{
	"name": "talos",
	"version": "0.3.0",
	"description": "TALOS — Obsidian 原生插件：超级大脑控制台 + 屈原 AI Agent 工作台。",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node build-styles.mjs && node esbuild.config.mjs",
		"build": "npm run licenses:check && tsc -noEmit -skipLibCheck && node build-styles.mjs && node esbuild.config.mjs production",
		"build:css": "node build-styles.mjs",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:quyuan": "node --experimental-strip-types quyuan-v2.selftest.mjs",
		"test:approval-actions": "node --experimental-strip-types approval-actions.selftest.mjs",
		"test:approval-executor": "node --experimental-strip-types approval-executor.selftest.mjs",
		"licenses:generate": "node third-party-licenses.mjs",
		"licenses:check": "node third-party-licenses.mjs --check",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "UNLICENSED",
	"private": true,
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.190",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@modelcontextprotocol/sdk": "~1.29.0",
		"smol-toml": "^1.6.1",
		"tslib": "^2.8.1"
	}
}
